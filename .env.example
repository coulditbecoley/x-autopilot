# Copy to .env and fill in only what your config uses. .env is git-ignored. Never commit it.

# Model (llm.provider). The claude-cli and codex-cli providers need no key here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Scraping the watched accounts (news and replies). apify.com > Settings > API & Integrations.
APIFY_TOKEN=

# publisher.type = x  (developer.x.com app with Read and Write, user access token for YOUR account)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# publisher.type = zernio
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=

# publisher.type = webhook
WEBHOOK_URL=
